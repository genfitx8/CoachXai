{
  "name": "coachxai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:coach": "cross-env VITE_APP_VARIANT=coach vite",
    "dev:student": "cross-env VITE_APP_VARIANT=student vite",
    "build": "npm run build:coach && npm run build:student",
    "build:coach": "cross-env VITE_APP_VARIANT=coach vite build",
    "build:student": "cross-env VITE_APP_VARIANT=student vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node scripts/runEval.mjs evals/shot_analysis.eval.json evals/coachx_chat.eval.json evals/motion_capture.eval.json",
    "eval:real": "node scripts/runEval.mjs --real evals/shot_analysis.eval.json evals/coachx_chat.eval.json evals/motion_capture.eval.json",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "cap:add:coach:android": "npm run build:coach   && node scripts/cap-run.mjs coach add android",
    "cap:add:coach:ios": "npm run build:coach   && node scripts/cap-run.mjs coach add ios",
    "cap:add:student:android": "npm run build:student && node scripts/cap-run.mjs student add android",
    "cap:add:student:ios": "npm run build:student && node scripts/cap-run.mjs student add ios",
    "cap:sync:coach": "npm run build:coach   && node scripts/cap-run.mjs coach sync",
    "cap:sync:student": "npm run build:student && node scripts/cap-run.mjs student sync",
    "cap:open:coach:android": "node scripts/cap-run.mjs coach open android",
    "cap:open:coach:ios": "node scripts/cap-run.mjs coach open ios",
    "cap:open:student:android": "node scripts/cap-run.mjs student open android",
    "cap:open:student:ios": "node scripts/cap-run.mjs student open ios"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.2",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/push-notifications": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tosspayments/tosspayments-sdk": "^2.6.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.13.4",
    "fabric": "^5.5.2",
    "firebase": "^12.6.0",
    "lucide-react": "^0.555.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.0"
  }
}
