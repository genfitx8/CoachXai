# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-coach
dist-student
dist-ssr
*.local

# Transient symlink written by scripts/cap-run.mjs — never commit
capacitor.config.ts
capacitor.config.ts.bak-*

# Eval run logs — per-timestamp markdown output from scripts/runEval.mjs.
# Never commit: they capture full model output (may contain member names /
# scenario data) and rotate on every run.
evals/runs/

# Local Android build outputs / IDE state
native/**/android/.gradle/
native/**/android/build/
native/**/android/app/build/
native/**/android/local.properties
native/**/android/.idea/
native/**/android/**/*.iml

# Local iOS Xcode state and CocoaPods artifacts
native/**/ios/App/Pods/
native/**/ios/App/Podfile.lock
native/**/ios/App/build/
native/**/ios/App/App.xcodeproj/xcuserdata/
native/**/ios/App/App.xcworkspace/xcuserdata/
native/**/ios/DerivedData/

# Signing material — must never be committed
*.keystore
*.jks
*.mobileprovision
*.p12

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment secrets — NEVER commit real credentials
.env
.env.bak
.env.local
.env.production

# Server
server/node_modules/
server/dist/

# Payment order data (local dev only)
server/data/payment_orders.json
